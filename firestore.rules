rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Вспомогательные функции авторизации и ролей
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : (exists(/databases/$(database)/documents/librarians/$(request.auth.uid))
            ? get(/databases/$(database)/documents/librarians/$(request.auth.uid)).data
            : {});
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().get('role', '') == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isLibrarian() {
      return isAdmin() || isRole('librarian');
    }

    // ==========================================
    // Коллекция config (системная конфигурация / инициализация)
    // ==========================================
    match /config/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/config/system);
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // Коллекции users и librarians
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isLibrarian();
      allow create: if (
        (isOwner(userId) && !exists(/databases/$(database)/documents/config/system)) ||
        isAdmin() ||
        (isLibrarian() && request.resource.data.role in ['student', 'librarian'])
      );
      allow update: if isLibrarian();
      allow delete: if isAdmin();
    }

    match /librarians/{userId} {
      allow read: if isLibrarian();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // Коллекция students_directory (справочник учеников и классов)
    // ==========================================
    match /students_directory/{studentId} {
      // Библиотекари и админы могут читать справочник для выбора при выдаче
      allow read: if isLibrarian();

      // Управление справочником учеников (добавление, редактирование, массовый перевод)
      allow create, update, delete: if isAdmin() || isLibrarian();
    }

    // ==========================================
    // Коллекция loans (журнал выдачи и возврата книг)
    // ==========================================
    match /loans/{loanId} {
      // Библиотекари и администраторы имеют полный доступ к журналу выдачи
      allow read, create, update, delete: if isLibrarian();
    }

    // ==========================================
    // Коллекция books (каталог книг)
    // ==========================================
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isLibrarian();
    }

    // ==========================================
    // Запрет доступа ко всем остальным путям по умолчанию
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
